<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline checks for GhostBuilder v2. Compiles the REAL source files - GhostBuilder_Architecture.cs
       (P2 proposal contract), GhostReviewWindow.cs (P3 gate), and the P2 SENSE pair
       DocumentTextReader.cs + GhostEvidence.cs - none of which touch the Revit API, so all of it can be
       proven without Revit installed. Run with `dotnet run` from this folder. UseWPF + STA because the
       review gate is a WPF window (constructed, never shown). Lives OUTSIDE SentinelAddin so the
       add-in's source glob never picks up its Main(). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>ghost-p2-check</AssemblyName>
    <RootNamespace>Sentinel.Checks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\SentinelAddin\GhostBuilder\GhostBuilder_Architecture.cs" />
    <Compile Include="..\..\SentinelAddin\GhostBuilder\GhostEvidence.cs" />
    <Compile Include="..\..\SentinelAddin\Standards\DocumentTextReader.cs" />
    <Compile Include="..\..\SentinelAddin\GhostBuilder\LayerRulesetMatcher.cs" />
    <Compile Include="..\..\SentinelAddin\GhostBuilder\LayerMapper.cs" />
    <Compile Include="..\..\SentinelAddin\UI\GhostReviewWindow.cs" />
  </ItemGroup>
</Project>
