<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check for RvtFileInfo.cs — pure OLE byte-scan version detection, net8. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>rvtinfo-check</AssemblyName>
    <RootNamespace>Sentinel.Checks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\SentinelAddin\Engine\RvtFileInfo.cs" Link="RvtFileInfo.cs" />
    <Compile Include="..\..\SentinelAddin\Engine\UpgradeQueue.cs" Link="UpgradeQueue.cs" />
  </ItemGroup>
</Project>
