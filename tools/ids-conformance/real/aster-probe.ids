<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>Sentinel IDS probe for a real Revit IFC2X3 model (Aster Tower)</title>
    </info>
    <specifications>
        <specification name="S1 wall names follow Basic Wall:…" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALLSTANDARDCASE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="Basic Wall:.*" />
                        </xs:restriction>
                    </value>
                </attribute>
            </requirements>
        </specification>
        <specification name="S2 walls say IsExternal as a boolean" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALLSTANDARDCASE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCBOOLEAN" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>IsExternal</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="S3 external walls are load-bearing" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALLSTANDARDCASE</simpleValue>
                    </name>
                </entity>
                <property>
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>IsExternal</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>true</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>LoadBearing</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>true</simpleValue>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="S4 IFCWALL is the class itself" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="S5 doors carry a fire rating" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCDOOR</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_DoorCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>FireRating</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="S6 window fire rating from a list" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWINDOW</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WindowCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>FireRating</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="0.5h" />
                            <xs:enumeration value="1h" />
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="S7 window U-value at most 3.0" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWINDOW</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WindowCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>ThermalTransmittance</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:maxInclusive value="3.0" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="S8 floor slabs are internal" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCSLAB</simpleValue>
                    </name>
                    <predefinedType>
                        <simpleValue>FLOOR</simpleValue>
                    </predefinedType>
                </entity>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_SlabCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>IsExternal</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>false</simpleValue>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="S9 storey names are L + digits" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="L\d+" />
                        </xs:restriction>
                    </value>
                </attribute>
            </requirements>
        </specification>
        <specification name="S10 no building element proxies" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGELEMENTPROXY</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements />
        </specification>
        <specification name="S11 the model has spaces" ifcVersion="IFC2X3">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCSPACE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="S12 door width 0.8-1.2 m (IDS values are SI)" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCDOOR</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>BaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Width</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minInclusive value="0.8" fixed="false" />
                            <xs:maxInclusive value="1.2" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="S13 walls carry an ObjectType" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALLSTANDARDCASE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>ObjectType</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="S14 storeys say AboveGround" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_BuildingStoreyCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>AboveGround</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="S15 walls carry a material" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALLSTANDARDCASE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <material cardinality="required" />
            </requirements>
        </specification>
        <specification name="S16 walls have a Gypsum Wall Board layer" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALLSTANDARDCASE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <material cardinality="required">
                    <value>
                        <simpleValue>Gypsum Wall Board</simpleValue>
                    </value>
                </material>
            </requirements>
        </specification>
        <specification name="S17 walls are classified in Uniformat (from their type)" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALLSTANDARDCASE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <classification cardinality="required">
                    <system>
                        <simpleValue>Uniformat</simpleValue>
                    </system>
                </classification>
            </requirements>
        </specification>
        <specification name="S18 walls are Uniformat B2010 exterior walls" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALLSTANDARDCASE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <classification cardinality="required">
                    <value>
                        <simpleValue>B2010</simpleValue>
                    </value>
                    <system>
                        <simpleValue>Uniformat</simpleValue>
                    </system>
                </classification>
            </requirements>
        </specification>
        <specification name="S19 walls are contained in a building storey" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALLSTANDARDCASE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required">
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                        </name>
                    </entity>
                </partOf>
            </requirements>
        </specification>
        <specification name="S20 windows fill an opening in a wall" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWINDOW</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <partOf relation="IFCRELVOIDSELEMENT IFCRELFILLSELEMENT" cardinality="required">
                    <entity>
                        <name>
                            <simpleValue>IFCWALLSTANDARDCASE</simpleValue>
                        </name>
                    </entity>
                </partOf>
            </requirements>
        </specification>
        <specification name="S21 storeys are part of a building" ifcVersion="IFC2X3">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <partOf relation="IFCRELAGGREGATES" cardinality="required">
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDING</simpleValue>
                        </name>
                    </entity>
                </partOf>
            </requirements>
        </specification>
    </specifications>
</ids>