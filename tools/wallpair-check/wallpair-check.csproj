<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check for WallPairing.cs — pure 2D geometry, no Revit, so it runs on plain net8. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>wallpair-check</AssemblyName>
    <RootNamespace>Sentinel.Checks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\SentinelAddin\GhostBuilder\WallPairing.cs" />
    <Compile Include="..\..\SentinelAddin\GhostBuilder\GuidelineMatcher.cs" />
  </ItemGroup>
</Project>
