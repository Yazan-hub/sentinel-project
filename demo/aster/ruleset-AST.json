{
  "schema_version": 1,
  "standard_key": "ast-std-001",
  "semver": "1.0.0",
  "org": "AST",
  "doc_refs": {
    "rtg": "{org}-STD-001",
    "bep": "{org}-BEP-001"
  },
  "rules": [
    {
      "id": "WS-01",
      "target": "workset",
      "mode": "warn",
      "whitelist": [
        "ARC_Walls",
        "ARC_Doors",
        "INT_Finishes",
        "STR_Frame",
        "Shared Levels and Grids"
      ],
      "message_en": "Workset '{name}' is not in the {org} workset whitelist.",
      "message_ar": "مجموعة العمل '{name}' غير مدرجة في قائمة {org} المعتمدة.",
      "doc_ref": "{org}-STD-001 §4"
    },
    {
      "id": "VN-01",
      "target": "view",
      "mode": "request",
      "tokens": [
        "DISC",
        "LEVEL",
        "TYPE",
        "DESC"
      ],
      "token_defs": {
        "DISC": "ARC|INT|STR|MEP",
        "LEVEL": "L\\d{2}|LRF|XX",
        "TYPE": "PLAN|RCP|SEC|ELEV|DET|3D|SCH",
        "DESC": "[A-Za-z0-9/&\\- ]+"
      },
      "separator": "_",
      "whitelist": [],
      "exclusions": [
        "^<.*>",
        "^\\{3D"
      ],
      "message_en": "View '{name}' does not match [DISCIPLINE]_[LEVEL]_[TYPE]_[DESCRIPTION].",
      "message_ar": "اسم العرض '{name}' لا يطابق نمط التسمية المعتمد.",
      "doc_ref": "{org}-STD-001 §2"
    },
    {
      "id": "VP-01",
      "target": "parameter",
      "mode": "warn",
      "parameter_name": "{org}_View Status",
      "exclusions": [
        "^<.*>",
        "^\\{3D"
      ],
      "message_en": "View '{name}': '{org}_View Status' is empty.",
      "message_ar": "العرض '{name}': حقل '{org}_View Status' فارغ.",
      "doc_ref": "{org}-STD-001 §2"
    },
    {
      "id": "SN-01",
      "target": "sheet",
      "mode": "request",
      "tokens": [
        "ORG",
        "DISC",
        "ZONE",
        "NUM"
      ],
      "token_defs": {
        "ORG": "{org}",
        "DISC": "ARC|INT|STR|MEP",
        "ZONE": "ZZ|Z\\d{1,2}",
        "NUM": "\\d{2}"
      },
      "separator": "-",
      "message_en": "Sheet '{name}' does not match {org}-[DISCIPLINE]-[ZONE]-[nn].",
      "message_ar": "رقم اللوحة '{name}' لا يطابق سلسلة ISO 19650.",
      "doc_ref": "{org}-STD-001 §2"
    },
    {
      "id": "FN-01",
      "target": "family",
      "mode": "warn",
      "tokens": [
        "ORG",
        "BODY"
      ],
      "token_defs": {
        "ORG": "{org}",
        "BODY": "((INT|EXT|STR)_)?[A-Za-z0-9][A-Za-z0-9 \\-\\+]*(_[A-Za-z0-9][A-Za-z0-9 \\-\\+]*)+"
      },
      "separator": "_",
      "categories": [
        "Doors",
        "Windows",
        "Furniture",
        "Casework",
        "Plumbing Fixtures",
        "Specialty Equipment",
        "Generic Models"
      ],
      "message_en": "Family '{name}' does not match {org}_[LOCATION]_[TYPE]_[VARIANT].",
      "message_ar": "العائلة '{name}' لا تطابق نمط تسمية {org}.",
      "doc_ref": "{org}-STD-001 §3"
    },
    {
      "id": "TN-01",
      "token_infer": {
        "LOC": {
          "by_parameter": {
            "Function": {
              "Exterior": "EXT",
              "Interior": "INT",
              "Foundation": "FND",
              "Retaining": "FND",
              "Soffit": "EXT",
              "Core-shaft": "INT"
            }
          },
          "by_category": {
            "Ceilings": "INT",
            "Floors": "INT",
            "Roofs": "EXT"
          }
        },
        "DISC": {
          "by_category": {
            "Walls": "ARC",
            "Floors": "ARC",
            "Ceilings": "ARC",
            "Roofs": "ARC"
          }
        }
      },
      "target": "type",
      "mode": "monitor",
      "tokens": [
        "ORG",
        "LOC",
        "DISC",
        "MATERIAL",
        "SIZE"
      ],
      "token_defs": {
        "ORG": "{org}",
        "LOC": "EXT|INT|FND",
        "DISC": "ARC|STR|LSE|INT|MEP|CIV",
        "MATERIAL": "[A-Z0-9][A-Z0-9 \\-]*",
        "SIZE": "\\d+(\\.\\d+)? mm"
      },
      "token_aliases": {
        "MATERIAL": {
          "GYPSUM": "GYP",
          "GYPSUM BOARD": "GYP",
          "GWB": "GYP",
          "PLASTERBOARD": "GYP",
          "DRYWALL": "GYP",
          "ACT": "ACT",
          "ACOUSTIC": "ACT",
          "ACOUSTICAL": "ACT",
          "CONCRETE": "CON",
          "CONC": "CON",
          "BLOCK": "BLK",
          "BLOCKWORK": "BLK",
          "CMU": "BLK",
          "BRICK": "BRK",
          "BRICKWORK": "BRK",
          "STEEL": "STL",
          "TIMBER": "TMB",
          "WOOD": "TMB",
          "GLASS": "GLS",
          "GLAZING": "GLS",
          "GLZ": "GLS",
          "ALUMINIUM": "ALU",
          "ALUMINUM": "ALU",
          "STONE": "STN",
          "MARBLE": "STN",
          "GRANITE": "STN",
          "TILE": "TIL",
          "CERAMIC": "TIL",
          "PLASTER": "PLS",
          "RENDER": "PLS",
          "INSULATION": "INS",
          "METAL": "MTL"
        }
      },
      "separator": "_",
      "categories": [
        "Walls",
        "Floors",
        "Ceilings",
        "Roofs"
      ],
      "message_en": "Type '{name}' does not match {org}_[LOC]_[DISC]_[MATERIAL]_[SIZE] mm.",
      "doc_ref": "{org}-STD-001 §3 (system family types)"
    },
    {
      "id": "TN-02",
      "token_infer": {
        "LOC": {
          "by_parameter": {
            "Function": {
              "Exterior": "EXT",
              "Interior": "INT"
            }
          }
        },
        "MATERIAL": {
          "by_parameter": {
            "Door Material": {},
            "Panel Material": {},
            "Frame Material": {}
          }
        }
      },
      "target": "type",
      "mode": "monitor",
      "tokens": [
        "ORG",
        "LOC",
        "LEAF",
        "MATERIAL",
        "SIZE"
      ],
      "token_defs": {
        "ORG": "{org}",
        "LOC": "EXT|INT",
        "LEAF": "\\d+ PNL|[A-Z0-9][A-Z0-9 \\-]*",
        "MATERIAL": "[A-Z0-9][A-Z0-9 \\-]*",
        "SIZE": "\\d+ x \\d+ mm"
      },
      "token_aliases": {
        "MATERIAL": {
          "GYPSUM": "GYP",
          "GYPSUM BOARD": "GYP",
          "GWB": "GYP",
          "PLASTERBOARD": "GYP",
          "DRYWALL": "GYP",
          "ACT": "ACT",
          "ACOUSTIC": "ACT",
          "ACOUSTICAL": "ACT",
          "CONCRETE": "CON",
          "CONC": "CON",
          "BLOCK": "BLK",
          "BLOCKWORK": "BLK",
          "CMU": "BLK",
          "BRICK": "BRK",
          "BRICKWORK": "BRK",
          "STEEL": "STL",
          "TIMBER": "TMB",
          "WOOD": "TMB",
          "GLASS": "GLS",
          "GLAZING": "GLS",
          "GLZ": "GLS",
          "ALUMINIUM": "ALU",
          "ALUMINUM": "ALU",
          "STONE": "STN",
          "MARBLE": "STN",
          "GRANITE": "STN",
          "TILE": "TIL",
          "CERAMIC": "TIL",
          "PLASTER": "PLS",
          "RENDER": "PLS",
          "INSULATION": "INS",
          "METAL": "MTL"
        },
        "LEAF": {
          "SINGLE": "1 PNL",
          "SGL": "1 PNL",
          "DOUBLE": "2 PNL",
          "DBL": "2 PNL",
          "BIFOLD": "2 PNL",
          "1 PNL": "1 PNL",
          "2 PNL": "2 PNL"
        }
      },
      "separator": "_",
      "categories": [
        "Doors",
        "Windows"
      ],
      "message_en": "Type '{name}' does not match {org}_[LOC]_[LEAF]_[MATERIAL]_[W x H] mm.",
      "doc_ref": "{org}-STD-001 §3 (doors and windows)"
    },
    {
      "id": "LV-01",
      "target": "level",
      "mode": "monitor",
      "tokens": [
        "LEVEL"
      ],
      "token_defs": {
        "LEVEL": "(L\\d{2}|LB\\d|LMZ|LRF)_(FFL|SSL)|STREET LEVEL"
      },
      "separator": "_",
      "message_en": "Level '{name}' does not match Lnn_FFL / Lnn_SSL.",
      "doc_ref": "{org}-STD-001 (proposed)"
    },
    {
      "id": "GR-01",
      "target": "grid",
      "mode": "monitor",
      "tokens": [
        "GRID"
      ],
      "token_defs": {
        "GRID": "[A-Z]{1,2}|\\d{1,3}"
      },
      "separator": "_",
      "message_en": "Grid '{name}' is not letters-or-numbers.",
      "doc_ref": "{org}-STD-001 (proposed)"
    }
  ]
}
