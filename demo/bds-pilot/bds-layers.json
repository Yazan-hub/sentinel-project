{
  "$schema": "https://sentinel.dev/schemas/dwg-layers-v1.json",
  "version": 1,
  "standard": "BDS DWG Layer Standard v1",
  "doc": "docs/BDS_DWG_LAYER_STANDARD.md",
  "format": "D-MAJR-MINR[-STATUS]",
  "enforce": "warn",
  "match": { "caseInsensitive": true, "trim": true },

  "ignore": [
    "0", "DEFPOINTS",
    "*-ANNO-*", "*-ANNO", "*-DIMS", "*-TEXT", "*-GRID", "*-DETL",
    "*-PATT", "*-SECT", "*-ELEV", "*-NPLT", "*-HATCH"
  ],

  "disciplines": {
    "A": "Architectural", "S": "Structural", "M": "Mechanical",
    "E": "Electrical", "P": "Plumbing", "F": "Fire protection",
    "C": "Civil", "I": "Interiors", "G": "General"
  },

  "layers": [
    { "layer": "A-WALL-EXT",  "category": "Walls",   "family": "BDS_Wall_Ext",       "params": { "IsExternal": true,  "Discipline": "A" }, "aliases": ["A-WALL-E", "WALL-EXT", "A-WALL-EXTERNAL"] },
    { "layer": "A-WALL-INT",  "category": "Walls",   "family": "BDS_Wall_Int",       "params": { "IsExternal": false, "Discipline": "A" }, "aliases": ["A-WALL-I", "WALL-INT", "A-WALL-INTERNAL"] },
    { "layer": "A-WALL-FIRE", "category": "Walls",   "family": "BDS_Wall_Fire",      "params": { "Discipline": "A" }, "requires": ["FireRating"], "aliases": ["A-WALL-FR", "A-WALL-RATED"] },
    { "layer": "A-WALL-PART", "category": "Walls",   "family": "BDS_Wall_Partition", "params": { "IsExternal": false, "Discipline": "A" }, "aliases": ["A-WALL-P", "A-PART"] },
    { "layer": "A-WALL",      "category": "Walls",   "family": "BDS_Wall_Int",       "params": { "Discipline": "A" }, "aliases": ["WALL", "WALLS"] },

    { "layer": "A-DOOR",      "category": "Doors",   "family": "BDS_Door",           "params": { "Discipline": "A" }, "aliases": ["DOOR", "DOORS", "A-DOR"] },
    { "layer": "A-WIND",      "category": "Windows", "family": "BDS_Window",         "params": { "Discipline": "A" }, "aliases": ["A-GLAZ", "WIND", "WINDOW", "WINDOWS", "A-WIN"] },

    { "layer": "A-FLOR",      "category": "Floors",  "family": "BDS_Floor",          "params": { "Discipline": "A" }, "aliases": ["A-FLR", "FLOOR", "FLOORS", "A-SLAB"] },
    { "layer": "A-FLOR-FNSH", "category": "Floors",  "family": "BDS_Floor_Finish",   "params": { "Discipline": "A" }, "aliases": ["A-FLR-FIN", "A-FINISH"] },
    { "layer": "A-CLNG",      "category": "Ceilings","family": "BDS_Ceiling",        "params": { "Discipline": "A" }, "aliases": ["A-CEIL", "CEILING", "CEILINGS"] },
    { "layer": "A-COLS",      "category": "Columns", "family": "BDS_Column_Arch",    "params": { "Discipline": "A" }, "aliases": ["A-COL", "A-COLUMN"] },
    { "layer": "A-FURN",      "category": "Furniture","family": "BDS_Furniture",     "params": { "Discipline": "A" }, "aliases": ["A-FURNITURE", "FURN"] },
    { "layer": "A-EQPM",      "category": "Furniture","family": "BDS_Equipment",     "params": { "Discipline": "A" }, "aliases": ["A-EQUIP", "A-EQP"] },

    { "layer": "S-COLS",      "category": "Columns", "family": "BDS_Column_Struct",  "params": { "Discipline": "S" }, "aliases": ["S-COL"] },
    { "layer": "S-SLAB",      "category": "Floors",  "family": "BDS_Slab_Struct",    "params": { "Discipline": "S" }, "aliases": ["S-FLOR"] },
    { "layer": "S-WALL",      "category": "Walls",   "family": "BDS_Wall_Shear",     "params": { "Discipline": "S" }, "aliases": ["S-WALL-SHEAR"] }
  ],

  "extensions": [
    { "layer": "A-STRS", "major": "STRS", "note": "Stairs — needs placement-engine support (not a v1 GhostBuilder category)" },
    { "layer": "A-ROOF", "major": "ROOF", "note": "Roofs — extension" },
    { "layer": "S-BEAM", "major": "BEAM", "note": "Beams — extension" },
    { "layer": "M-DUCT", "major": "DUCT", "note": "HVAC duct → MEP void via MepVoidManager", "params": { "Discipline": "M" } },
    { "layer": "P-PIPE", "major": "PIPE", "note": "Pipe → MEP void via MepVoidManager", "params": { "Discipline": "P" } }
  ]
}
