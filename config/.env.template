# Sentinel Bridge — environment template.
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# That Open Platform. NOTE: this API is not officially documented; base URL + auth were taken
# from the open-source @thatopen/services SDK and may change. See SentinelAddin/Platform/PlatformClient.cs.
# Base host is https://platform.thatopen.com (the SDK appends /api). NOT api.thatopen.com.
THATOPEN_API_BASE_URL=https://platform.thatopen.com/api
# Dashboard-issued Platform API token (ThatOpen dashboard -> Data -> API Tokens). Server-side only.
THATOPEN_API_KEY=replace-with-your-dashboard-api-token
THATOPEN_PROJECT_ID=replace-with-your-project-id
# The Sentinel project (its key) the platform delivery gate's runs are recorded on. Unset: the one live Sentinel project
# that links THATOPEN_PROJECT_ID (Settings ▸ General). Set: that project only — its link must be THATOPEN_PROJECT_ID.
# THATOPEN_GATE_PROJECT_KEY=replace-with-the-sentinel-project-key

# Local paths Sentinel already writes to — the Bridge watches these.
SENTINEL_APPDATA_DIR=%APPDATA%\Sentinel

# Bridge auth gate (see docs/SECURITY_F2_ACTIVATION.md). BCF_TOKEN is required: the bridge refuses
# to start while it is empty, on loopback too (SEC-1). An empty value in this file still overrides a
# real env var, so set it — never blank the line.
# Shared secret for trusted desktop clients (Revit add-in, mcp-server.mjs).
# BCF_TOKEN=replace-with-a-long-random-secret
# Supabase project JWT secret (Supabase dashboard -> project settings -> API). Turns on real
# HS256 signature+exp+role verification for forwarded SPA JWTs (role must be "authenticated" —
# the public anon key is deliberately rejected). Optional for loopback, recommended once hosted.
# SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret
# CSRF allowlist for browser-origin mutations (comma-separated). "*" disables the check (dev only).
# BCF_CORS_ORIGIN=https://your-app-origin
# A raw upload (an IFC, a document) whose average rate is below BCF_MIN_UPLOAD_KBPS once its first BCF_UPLOAD_GRACE_S
# seconds are over is refused (408, in words). The bridge log prints "[upload] <MB> in <s> s (<KB/s>)" for every upload
# that lands: set the floor from those lines.
# BCF_MIN_UPLOAD_KBPS=16
# BCF_UPLOAD_GRACE_S=120
# An empty or 0 value keeps the default: the floor is never off, 1 is its lowest.
# Body caps, in MB — each read when a body is read; an empty or 0 value keeps the default. A body over its cap is a 413 in words.
# A model upload (POST /ifc, Governed Intake, the manifests backfill, judge-again) is held whole in memory, twice over while it is read:
# raise this one for a bigger IFC.
# BCF_MAX_UPLOAD_MB=1024
# Any JSON body.
# BCF_MAX_JSON_MB=16
# An encrypted CDE attachment (POST /cde/files).
# SENTINEL_MAX_BLOB_MB=100
# A document for ingest (POST /bimdocs/:key/ingest).
# SENTINEL_MAX_DOC_MB=32
