<UserControl x:Class="Sentinel.UI.SentinelPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No MinWidth: Revit docks the pane narrower than any minimum (beside Speckle it was ~193 DIP) and clips what
         is wider - lines cut and the refresh button out of reach (drill MA2b). Every line wraps to the dock instead;
         tools/pane-layout-check lays this XAML out at 160, 193 and 420 DIP wide, 720 and 900 high. -->
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Padding="8,6" CornerRadius="4" Background="#EEF3EA" Margin="0,0,0,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="↻" Width="24" Height="22" VerticalAlignment="Top"
                        Margin="6,0,0,0" Click="OnJourneyRefreshClick"
                        ToolTip="Refresh the journey from the web (read-only)"/>
                <!-- Capped and scrolling: wrapped in a narrow dock the journey runs ~480 DIP tall and would leave the rule grid
                     no rows (review of the narrow-dock fix); the ↻ button stays outside, always in view. -->
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding JourneyKey}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StandardsLine}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NextLine}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LodLine}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PublishLine}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ScanRulesetLine}" FontSize="11" Foreground="#667" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="8" CornerRadius="4" Background="#F0F3F7">
            <StackPanel>
                <TextBlock Text="{Binding ScoreText}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#667" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Expander DockPanel.Dock="Bottom" Header="{Binding DoctorHeader}" FontSize="11"
                  Margin="0,6,0,0" IsExpanded="False">
            <Expander.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Expander.HeaderTemplate>
            <ListBox ItemsSource="{Binding DoctorLog}" MaxHeight="140" FontSize="11"
                     FontFamily="Consolas" BorderThickness="0" Background="#F7F9FB"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <DataGrid ItemsSource="{Binding Violations}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  MouseDoubleClick="OnRowDoubleClick" Margin="0,8,0,0"
                  SelectionMode="Single" x:Name="Grid">
            <DataGrid.Columns>
                <!-- ⚡ first: the columns are wider than a docked pane, so a last column scrolls out of reach (drill F3) -->
                <DataGridTemplateColumn Header="" Width="58">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="⚡ Fix" FontSize="11" Padding="6,1" Margin="2"
                                    Background="#1E3A5F" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Click="OnFixClick"
                                    ToolTip="Rename this element to match the naming schema (on a REQUEST rule: file a proposal for a coordinator to approve)"
                                    Visibility="{Binding FixVisibility}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="55"/>
                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="70"/>
                <DataGridTextColumn Header="Element" Binding="{Binding ElementName}" Width="130"/>
                <!-- MinWidth: the fixed columns already take 418 DIP, so a star column alone shrank to 20 DIP and no message could be
                     read at any dock width; it keeps 160 and the grid scrolls sideways to it -->
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="160"/>
                <DataGridTextColumn Header="Ref" Binding="{Binding DocRef}" Width="105"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="BLOCK">
                            <Setter Property="Background" Value="#FDE2E2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Mode}" Value="REQUEST">
                            <Setter Property="Background" Value="#FFF2D9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Mode}" Value="WARN">
                            <Setter Property="Background" Value="#FFFBE6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</UserControl>
