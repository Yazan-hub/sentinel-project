<Window x:Class="Sentinel.UI.ClashManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinel — Clash Manager"
        Width="860" Height="620" WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E3A5F" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Clash Manager" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubHeader" Foreground="#9DB4CE" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="White" Padding="20,8"
                BorderBrush="#E3E8EF" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Severity:" FontSize="11" Foreground="#667" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Background="#FBE3E3" CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                    <TextBlock Text="HARD" FontSize="10" FontWeight="Bold" Foreground="#B3352F"/>
                </Border>
                <Border Background="#FDEBD8" CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                    <TextBlock Text="MEDIUM" FontSize="10" FontWeight="Bold" Foreground="#C2611A"/>
                </Border>
                <Border Background="#FFFBE6" CornerRadius="10" Padding="10,3">
                    <TextBlock Text="SOFT" FontSize="10" FontWeight="Bold" Foreground="#B07D10"/>
                </Border>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" Padding="20,10"
                BorderBrush="#E3E8EF" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Show element" Width="110" Height="30" Margin="0,0,8,0" Click="OnShow"/>
                <Button Content="Export BCF" Width="100" Height="30" Margin="0,0,8,0" Click="OnExportBcf"/>
                <Button Content="Create 3D clash view" Width="150" Height="30"
                        Background="#1E3A5F" Foreground="White" BorderThickness="0" Click="OnCreateView"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" Margin="14"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Extended" Background="White" BorderBrush="#E3E8EF">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Grade}" Width="80"/>
                <DataGridTextColumn Header="Host element" Binding="{Binding HostName}" Width="160"/>
                <DataGridTextColumn Header="Category" Binding="{Binding HostCategory}" Width="100"/>
                <DataGridTextColumn Header="Host ID" Binding="{Binding HostId}" Width="80"/>
                <DataGridTextColumn Header="MEP element" Binding="{Binding OtherName}" Width="150"/>
                <DataGridTextColumn Header="Link" Binding="{Binding LinkName}" Width="120"/>
                <DataGridTextColumn Header="Location" Binding="{Binding LocationText}" Width="150"/>
                <DataGridTextColumn Header="Vol m³" Binding="{Binding VolumeM3}" Width="60"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Grade}" Value="Hard">
                            <Setter Property="Background" Value="#FBE3E3"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Grade}" Value="Medium">
                            <Setter Property="Background" Value="#FDEBD8"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Grade}" Value="Soft">
                            <Setter Property="Background" Value="#FFFBE6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</Window>
