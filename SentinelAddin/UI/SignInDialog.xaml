<Window x:Class="Sentinel.UI.SignInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinel — Sign in"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#F4F6F9">
    <StackPanel>
        <Border Background="#1E3A5F" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Sign in" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Your Sentinel account — the same one as on the web. Every governed call from Revit then carries your name."
                           Foreground="#9DB4CE" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="20,16">
            <TextBlock x:Name="WhoText" FontSize="12" Foreground="#2E7D4F" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <StackPanel x:Name="Form">
                <TextBlock Text="E-mail" FontSize="11" Foreground="#667"/>
                <TextBox x:Name="EmailBox" Height="28" FontSize="12" Padding="6,4" Margin="0,4,0,10"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="Password" FontSize="11" Foreground="#667"/>
                <PasswordBox x:Name="PasswordBox" Height="28" FontSize="12" Padding="6,4" Margin="0,4,0,10"
                             VerticalContentAlignment="Center" KeyDown="OnPasswordKeyDown"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="11" Foreground="#B00020" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="WhereText" FontSize="10" Foreground="#889" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SignOutButton" Content="Sign out" Width="90" Height="30" Margin="0,0,8,0" Click="OnSignOut"/>
                <Button Content="Close" Width="80" Height="30" Margin="0,0,8,0" Click="OnClose"/>
                <Button x:Name="SignInButton" Content="Sign in" Width="90" Height="30"
                        Background="#1E3A5F" Foreground="White" BorderThickness="0" Click="OnSignIn"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
