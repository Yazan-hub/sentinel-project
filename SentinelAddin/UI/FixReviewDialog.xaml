<Window x:Class="Sentinel.UI.FixReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinel — Review Fix"
        Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F4F6F9">
    <StackPanel Margin="0">
        <Border Background="#1E3A5F" Padding="18,14">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="RuleText" Foreground="#9DB4CE" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="18,14">
            <TextBlock Text="Current value" FontSize="11" Foreground="#667"/>
            <TextBox x:Name="CurrentBox" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                     Foreground="#B3352F" Background="#FBF3F3" BorderBrush="#E3C8C8"
                     Padding="6,4" Margin="0,3,0,12"/>
            <TextBlock Text="Proposed value (editable)" FontSize="11" Foreground="#667"/>
            <TextBox x:Name="ProposedBox" FontFamily="Consolas" FontSize="13"
                     Foreground="#1E5631" Background="#F1F8F3" BorderBrush="#BFDCC8"
                     Padding="6,4" Margin="0,3,0,4" TextChanged="OnProposedChanged"/>
            <TextBlock x:Name="ValidityText" FontSize="11" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Click="OnCancel"/>
                <Button x:Name="ExecuteBtn" Content="Execute fix" Width="110" Height="30"
                        Background="#2E7D4F" Foreground="White" BorderThickness="0" Click="OnExecute"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
