  ],
  "viewNaming": {
    "structure": "[STATUS]_[TYPE]_[LEVEL]_[DESCRIPTION]",
    "source": "BDS-RTG-001 §5.1",
    "statusPrefixes": {
      "WIP_": "01_WIP_VIEWS",
      "SH_": "02_SHEET_VIEWS",
      "EXPORT_": "04_EXPORT_SCHEDULE"
    }
  }
}