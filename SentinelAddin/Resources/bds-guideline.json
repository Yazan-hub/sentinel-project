{
  "$schema": "https://sentinel.dev/schemas/office-guideline-v1.json",
  "version": 3,
  "standard": "BDS Office Modelling Guideline v3",
  "office": "BDS",
  "doc": "docs/superpowers/specs/2026-07-23-office-modelling-guideline.md",
  "audit": "docs/BDS_TEMPLATE_TYPE_AUDIT.md",
  "catalog": "demo/bds-pilot/bds-type-catalog.json",
  "references": {
    "layers": "bds-layers.json",
    "ids": "demo/bds-pilot/bds-ids.json",
    "naming": "WebApp/bridge/naming-ruleset.json"
  },
  "elements": [
    {
      "category": "Walls",
      "rules": [
        {
          "when": {
            "layer": "A-WALL-EXT",
            "params": {
              "Material": "STONE"
            }
          },
          "use": {
            "family": "Basic Wall",
            "typePattern": "BDS_EXT_ARC_STONE_{thickness} mm"
          },
          "why": "Spec calls for stone cladding externally."
        },
        {
          "when": {
            "layer": "A-WALL-EXT",
            "params": {
              "Material": "PORCELAIN"
            }
          },
          "use": {
            "family": "Basic Wall",
            "typePattern": "BDS_EXT_ARC_PORCELAIN_{thickness} mm"
          },
          "why": "Spec calls for porcelain cladding externally."
        },
        {
          "when": {
            "layer": "A-WALL-EXT",
            "params": {
              "Material": "MTL"
            }
          },
          "use": {
            "family": "Basic Wall",
            "typePattern": "BDS_EXT_ARC_MTL_{thickness} mm"
          },
          "why": "Spec calls for a metal external skin."
        },
        {
          "when": {
            "layer": "A-WALL-EXT",
            "discipline": "S"
          },
          "use": {
            "family": "Basic Wall",
            "typePattern": "BDS_EXT_STR_CONC_{thickness} mm"
          },
          "why": "External STRUCTURAL walls are concrete."
        },
        {
          "when": {
            "layer": "A-WALL-EXT"
          },
          "use": {
            "family": "Basic Wall",
            "typePattern": "BDS_EXT_ARC_CMU_{thickness} mm"
          },
          "why": "External architectural walls are CMU unless the spec says otherwise."
        },
        {
          "when": {
            "layer": "A-WALL-INT",
            "discipline": "S"
          },
          "use": {
            "family": "Basic Wall",
            "typePattern": "BDS_INT_STR_CONC_{thickness} mm"
          },
          "why": "Internal STRUCTURAL walls are concrete."
        },
        {
          "when": {
            "layer": "A-WALL-INT",
            "params": {
              "Material": "CMU"
            }
          },
          "use": {
            "family": "Basic Wall",
            "typePattern": "BDS_INT_ARC_CMU_{thickness} mm"
          },
          "why": "Spec calls for blockwork internally."
        },
        {
          "when": {
            "layer": "A-WALL-INT"
          },
          "use": {
            "family": "Basic Wall",
            "typePattern": "BDS_INT_ARC_GYPS_{thickness} mm"
          },
          "why": "Internal partitions are gypsum board unless the spec says otherwise."
        },
        {
          "when": {
            "layer": "A-WALL-PART"
          },
          "use": {
            "family": "Basic Wall",
            "typePattern": "BDS_INT_ARC_GYPS_{thickness} mm"
          },
          "why": "Partitions follow the internal architectural standard."
        }
      ],
      "default": {
        "family": "Basic Wall",
        "typePattern": "BDS_INT_ARC_GYPS_{thickness} mm"
      }
    },
    {
      "category": "Doors",
      "rules": [
        {
          "when": {
            "layer": "A-DOOR",
            "params": {
              "Location": "EXT",
              "Material": "WOOD"
            }
          },
          "use": {
            "family": "BDS_EXT_1 PNL",
            "type": "BDS_EXT_1 PNL_WOOD_1000 x 2100 mm"
          },
          "why": "EXT single-panel wood door, nominal opening from the type NAME (its Width parameter is the leaf, not the opening)."
        },
        {
          "when": {
            "layer": "A-DOOR",
            "params": {
              "Location": "EXT",
              "Material": "GLASS"
            }
          },
          "use": {
            "family": "BDS_EXT_1 PNL",
            "type": "BDS_EXT_1 PNL_GLASS_1000 x 2100 mm"
          },
          "why": "EXT single-panel glass door, nominal opening from the type NAME (its Width parameter is the leaf, not the opening)."
        },
        {
          "when": {
            "layer": "A-DOOR",
            "params": {
              "Location": "EXT",
              "Material": "STEEL"
            }
          },
          "use": {
            "family": "BDS_EXT_1 PNL",
            "type": "BDS_EXT_1 PNL_STEEL_1000 x 2100 mm"
          },
          "why": "EXT single-panel steel door, nominal opening from the type NAME (its Width parameter is the leaf, not the opening)."
        },
        {
          "when": {
            "layer": "A-DOOR",
            "params": {
              "Location": "INT",
              "Material": "WOOD"
            }
          },
          "use": {
            "family": "BDS_INT_1 PNL",
            "type": "BDS_INT_1 PNL_WOOD_1000 x 2100 mm"
          },
          "why": "INT single-panel wood door, nominal opening from the type NAME (its Width parameter is the leaf, not the opening)."
        },
        {
          "when": {
            "layer": "A-DOOR",
            "params": {
              "Location": "INT",
              "Material": "GLASS"
            }
          },
          "use": {
            "family": "BDS_INT_1 PNL",
            "type": "BDS_INT_1 PNL_GLASS_1000 x 2100 mm"
          },
          "why": "INT single-panel glass door, nominal opening from the type NAME (its Width parameter is the leaf, not the opening)."
        },
        {
          "when": {
            "layer": "A-DOOR",
            "params": {
              "Location": "INT",
              "Material": "STEEL"
            }
          },
          "use": {
            "family": "BDS_INT_1 PNL",
            "type": "BDS_INT_1 PNL_STEEL_1000 x 2100 mm"
          },
          "why": "INT single-panel steel door, nominal opening from the type NAME (its Width parameter is the leaf, not the opening)."
        }
      ],
      "default": {
        "family": "BDS_INT_1 PNL",
        "type": "BDS_INT_1 PNL_WOOD_1000 x 2100 mm"
      }
    },
    {
      "category": "Floors",
      "rules": [
        {
          "when": {
            "layer": "A-FLOR",
            "level": "Ground"
          },
          "use": {
            "family": "Floor",
            "type": "BDS_FND_STR_CONC-RAFT_2500 mm"
          },
          "why": "Ground floor is the concrete raft."
        }
      ],
      "default": {
        "family": "Floor",
        "type": "BDS_INT_ARC_CEMENTITOUS-WATERPROOFING_6 mm"
      }
    },
    {
      "category": "Ceilings",
      "rules": [
        {
          "when": {
            "layer": "A-CLNG"
          },
          "use": {
            "family": "Basic Ceiling",
            "type": "Generic"
          },
          "why": "Ceilings use the template's standard ceiling type."
        }
      ]
    },
    {
      "category": "Structural Columns",
      "rules": [
        {
          "when": {
            "layer": "S-COLS"
          },
          "use": {
            "family": "BDS_Column_Concrete_Rectangular",
            "type": "BDS_INT_STR_CONC_300 X 1500 mm"
          },
          "why": "Structural columns use the BDS concrete rectangular family. Size comes from the type name (300x300 / 300x1500 / 600x600)."
        }
      ]
    },
    {
      "category": "Windows",
      "rules": [
        {
          "when": {
            "layer": "A-WIND"
          },
          "use": {
            "family": "BDS_Window_1 Panel+FX",
            "type": "1000x3000 mm"
          },
          "why": "Windows default to the single-panel BDS family; size from the type name."
        }
      ]
    }
  ],
  "graphics": {
    "note": "Tag families harvested from the template. `officeAuthored: false` means the template is still on the stock Revit tag — a real gap in the office standard, not a Sentinel limitation.",
    "tags": {
      "Doors": {
        "family": "BDS_Door Tag",
        "type": "BDS_Door Tag",
        "officeAuthored": true
      },
      "Windows": {
        "family": "BDS_Window Tag",
        "type": "BDS_Window Tag",
        "officeAuthored": true
      },
      "Rooms": {
        "family": "BDS_Room Tag",
        "type": "Number, Number, Area_1-100",
        "officeAuthored": true
      },
      "Curtain Walls": {
        "family": "BDS_Curtain Wall Tag",
        "type": "8mm",
        "officeAuthored": true
      },
      "Walls": {
        "family": "M_Wall Tag",
        "type": "8mm",
        "officeAuthored": false
      },
      "Ceilings": {
        "family": "M_Ceiling Tag w Height",
        "officeAuthored": false
      },
      "Floors": {
        "family": "M_Floor Tag",
        "officeAuthored": false
      },
      "Columns": {
        "family": "M_Structural Column Tag",
        "officeAuthored": false
      },
      "Furniture": {
        "family": "M_Furniture Tag - Quantity",
        "officeAuthored": false
      },
      "Casework": {
        "family": "M_Casework Tag",
        "officeAuthored": false
      },
      "Stairs": {
        "family": "M_Stair Tag",
        "officeAuthored": false
      }
    },
    "dimensionStyle": null,
    "textStyle": null
  },
  "views": [
    {
      "use": "GA Plan",
      "wipTemplate": "01.100_WIP_FLOOR_PLANS",
      "sheetTemplate": "02.100_SHEET_FLOOR_PLANS",
      "viewType": "FloorPlan",
      "namePrefix": "FP",
      "tag": [
        "Doors",
        "Windows",
        "Rooms"
      ]
    },
    {
      "use": "Presentation Plan",
      "wipTemplate": "01.100_WIP_PRESENTATION_PLANS",
      "sheetTemplate": "02.100_SHEET_PRESENTATION_PLANS",
      "viewType": "FloorPlan",
      "namePrefix": "PP",
      "tag": [
        "Rooms"
      ]
    },
    {
      "use": "Presentation Plan (no colour)",
      "wipTemplate": "01.100_WIP_PRESENTATION_PLANS_NO COLOUR",
      "sheetTemplate": "02.100_SHEET_PRESENTATION_PLANS_NO COLOUR",
      "viewType": "FloorPlan",
      "namePrefix": "PP",
      "tag": [
        "Rooms"
      ]
    },
    {
