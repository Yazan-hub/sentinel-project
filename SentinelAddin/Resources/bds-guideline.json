{
  "$schema": "https://sentinel.dev/schemas/office-guideline-v1.json",
  "version": 1,
  "standard": "BDS Office Modelling Guideline v1",
  "office": "BDS",
  "doc": "docs/superpowers/specs/2026-07-23-office-modelling-guideline.md",
  "references": {
    "layers": "bds-layers.json",
    "ids": "demo/bds-pilot/bds-ids.json",
    "naming": "WebApp/bridge/naming-ruleset.json"
  },
  "elements": [
    {
      "category": "Walls",
      "rules": [
        {
          "when": {
            "layer": "A-WALL-EXT",
            "params": {
              "Fire Rating": "FR60"
            }
          },
          "use": {
            "family": "BDS_Wall_Ext",
            "type": "BDS_Wall_Ext_200_FR60",
            "params": {
              "Fire Rating": "FR60",
              "IsExternal": true
            }
          },
          "why": "External walls with a 60-minute rating use the rated build-up, not the standard 200."
        },
        {
          "when": {
            "layer": "A-WALL-EXT",
            "params": {
              "Fire Rating": "FR120"
            }
          },
          "use": {
            "family": "BDS_Wall_Ext",
            "type": "BDS_Wall_Ext_300_FR120",
            "params": {
              "Fire Rating": "FR120",
              "IsExternal": true
            }
          },
          "why": "120-minute rating requires the 300 cavity build-up."
        },
        {
          "when": {
            "layer": "A-WALL-EXT"
          },
          "use": {
            "family": "BDS_Wall_Ext",
            "params": {
              "IsExternal": true,
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-WALL-EXT is Walls."
        },
        {
          "when": {
            "layer": "A-WALL-INT"
          },
          "use": {
            "family": "BDS_Wall_Int",
            "params": {
              "IsExternal": false,
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-WALL-INT is Walls."
        },
        {
          "when": {
            "layer": "A-WALL-FIRE"
          },
          "use": {
            "family": "BDS_Wall_Fire",
            "params": {
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-WALL-FIRE is Walls."
        },
        {
          "when": {
            "layer": "A-WALL-PART"
          },
          "use": {
            "family": "BDS_Wall_Partition",
            "params": {
              "IsExternal": false,
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-WALL-PART is Walls."
        },
        {
          "when": {
            "layer": "A-WALL"
          },
          "use": {
            "family": "BDS_Wall_Int",
            "params": {
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-WALL is Walls."
        },
        {
          "when": {
            "layer": "S-WALL"
          },
          "use": {
            "family": "BDS_Wall_Shear",
            "params": {
              "Discipline": "S"
            }
          },
          "why": "BDS DWG Layer Standard: S-WALL is Walls."
        }
      ],
      "default": {
        "family": "BDS_Wall_Int",
        "type": "BDS_Wall_Int_100"
      }
    },
    {
      "category": "Doors",
      "rules": [
        {
          "when": {
            "layer": "A-DOOR"
          },
          "use": {
            "family": "BDS_Door",
            "params": {
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-DOOR is Doors."
        }
      ]
    },
    {
      "category": "Windows",
      "rules": [
        {
          "when": {
            "layer": "A-WIND"
          },
          "use": {
            "family": "BDS_Window",
            "params": {
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-WIND is Windows."
        }
      ]
    },
    {
      "category": "Floors",
      "rules": [
        {
          "when": {
            "layer": "A-FLOR",
            "level": "Ground"
          },
          "use": {
            "family": "BDS_Floor",
            "type": "BDS_Floor_200_RC"
          },
          "why": "Ground floor is a 200 reinforced concrete slab."
        },
        {
          "when": {
            "layer": "A-FLOR"
          },
          "use": {
            "family": "BDS_Floor",
            "params": {
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-FLOR is Floors."
        },
        {
          "when": {
            "layer": "A-FLOR-FNSH"
          },
          "use": {
            "family": "BDS_Floor_Finish",
            "params": {
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-FLOR-FNSH is Floors."
        },
        {
          "when": {
            "layer": "S-SLAB"
          },
          "use": {
            "family": "BDS_Slab_Struct",
            "params": {
              "Discipline": "S"
            }
          },
          "why": "BDS DWG Layer Standard: S-SLAB is Floors."
        }
      ]
    },
    {
      "category": "Ceilings",
      "rules": [
        {
          "when": {
            "layer": "A-CLNG"
          },
          "use": {
            "family": "BDS_Ceiling",
            "params": {
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-CLNG is Ceilings."
        }
      ]
    },
    {
      "category": "Columns",
      "rules": [
        {
          "when": {
            "layer": "A-COLS"
          },
          "use": {
            "family": "BDS_Column_Arch",
            "params": {
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-COLS is Columns."
        },
        {
          "when": {
            "layer": "S-COLS"
          },
          "use": {
            "family": "BDS_Column_Struct",
            "params": {
              "Discipline": "S"
            }
          },
          "why": "BDS DWG Layer Standard: S-COLS is Columns."
        }
      ]
    },
    {
      "category": "Furniture",
      "rules": [
        {
          "when": {
            "layer": "A-FURN"
          },
          "use": {
            "family": "BDS_Furniture",
            "params": {
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-FURN is Furniture."
        },
        {
          "when": {
            "layer": "A-EQPM"
          },
          "use": {
            "family": "BDS_Equipment",
            "params": {
              "Discipline": "A"
            }
          },
          "why": "BDS DWG Layer Standard: A-EQPM is Furniture."
        }
      ]
    }
  ],
  "graphics": {
    "dimensionStyle": "BDS_Dim_2.5mm_Arial",
    "textStyle": "BDS_Text_2.5mm_Arial",
    "tags": {
      "Walls": "BDS_Tag_Wall",
      "Doors": "BDS_Tag_Door",
      "Windows": "BDS_Tag_Window",
      "Floors": "BDS_Tag_Floor",
      "Columns": "BDS_Tag_Column",
      "Ceilings": "BDS_Tag_Ceiling"
    }
  },
  "views": [
    {
      "use": "GA Plan",
      "template": "BDS_GA_Plan",
      "scale": "1:100",
      "detailLevel": "Medium",
      "tag": [
        "Doors",
        "Windows",
        "Walls"
      ]
    },
    {
      "use": "RCP",
      "template": "BDS_RCP",
      "scale": "1:100",
      "detailLevel": "Medium",
      "tag": [
        "Ceilings"
      ]
    },
    {
      "use": "Section",
      "template": "BDS_Section",
      "scale": "1:50",
      "detailLevel": "Fine",
      "tag": [
        "Walls",
        "Floors"
      ]
    },
    {
      "use": "Detail",
      "template": "BDS_Detail",
      "scale": "1:5",
      "detailLevel": "Fine",
      "tag": []
    }
  ]
}
