      "wipTemplate": "01.700_WIP_PRESENTATION_CEILING PLANS",
      "sheetTemplate": "02.700_SHEET_PRESENTATION_CEILING PLANS",
      "viewType": "CeilingPlan",
      "namePrefix": "RCP",
      "tag": [
        "Ceilings"
      ]
    },
    {
      "use": "Elevation",
      "wipTemplate": "01.200_WIP_PRESENTATION_ELEVATIONS",
      "sheetTemplate": "02.200_SHEET_PRESENTATION_ELEVATIONS",
      "viewType": "Section",
