<Project Sdk="Microsoft.NET.Sdk">
  <!-- ============================================================
       Multi-version build: Revit 2021–2027 from one codebase.
       Select with:  dotnet build -p:RevitVersion=2023
       Or build all: powershell ./build.ps1
       ============================================================ -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>

    <!-- Deploy to the live Revit Addins folder after a build. On by default so a plain
         `dotnet build -p:RevitVersion=2024` installs straight to that version's folder.
         Pass -p:DeployToRevit=false for CI / package-only builds. -->
    <DeployToRevit Condition="'$(DeployToRevit)' == ''">true</DeployToRevit>

    <!-- 2021–2024 -> .NET Framework 4.8 · 2025–2026 -> .NET 8 · 2027 -> .NET 10 -->
    <TargetFramework Condition="$(RevitVersion) &lt;= 2024">net48</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) == 2025 Or $(RevitVersion) == 2026">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2027">net10.0-windows</TargetFramework>

    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Sentinel</AssemblyName>
    <RootNamespace>Sentinel</RootNamespace>
    <ImplicitUsings Condition="'$(TargetFramework)' == 'net8.0-windows' Or '$(TargetFramework)' == 'net10.0-windows'">enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Version defines for conditional API code, e.g. #if REVIT2024_OR_GREATER -->
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2022">$(DefineConstants);REVIT2022_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2023">$(DefineConstants);REVIT2023_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2024">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2025">$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2026">$(DefineConstants);REVIT2026_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API stubs matched to the target year; runtime excluded so we
         always bind to the DLLs of the installed Revit. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <!-- net48 needs the OOB package for System.Text.Json (+ JsonNamingPolicy.SnakeCaseLower, 8.0);
         net8/net10 ship it in-box, so referencing it there is redundant (NU1510). -->
    <PackageReference Include="System.Text.Json" Version="8.0.*" Condition="'$(TargetFramework)' == 'net48'" />
    <!-- Tier-2 document ingestion: pure-managed MIT PDF text extractor (netstandard2.0 → net48 + net8). -->
    <PackageReference Include="PdfPig" Version="0.1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped ruleset + ribbon icons: copied to output, deployed with the DLL -->
    <Content Include="Resources\ruleset.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\bds-layers.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Reference PROFILE, not a fixed standard (D-03). Another firm points ghost_guideline_path at
         their own file; this ships so the add-in works out of the box, not to lock anyone to BDS. -->
    <Content Include="Resources\bds-guideline.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- ImplicitUsings is net8-only; give net48 the same usings -->
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
  </ItemGroup>

  <!-- Deploy to the matching Revit Addins folder after build. The destination is resolved
       dynamically from $(RevitVersion), so `-p:RevitVersion=2024` installs to the 2024 folder
       and `-p:RevitVersion=2026` to the 2026 folder — for both the binaries and the manifest.
       Guarded on the Addins root existing so CI / machines without Revit don't get stray folders. -->
  <Target Name="DeployAddin" AfterTargets="Build"
          Condition="'$(DeployToRevit)' != 'false' And Exists('$(AppData)\Autodesk\Revit\Addins')">
    <!-- Running-Revit guard: a live Revit locks the deployed add-in DLLs. Without this, the Copy
         below fails, gets swallowed, and leaves a STALE install while the build still reports
         success. Detect Revit.exe and FAIL LOUDLY instead — close Revit, or build compile-only with
         -p:DeployToRevit=false. -->
    <Exec Command="tasklist /FI &quot;IMAGENAME eq Revit.exe&quot; /NH"
          ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_RevitTasklist" />
    </Exec>
    <Error Condition="'$(_RevitTasklist)' != '' And $(_RevitTasklist.Contains('Revit.exe'))"
           Text="Revit is running and locks the Sentinel add-in files — deploying now would silently leave a STALE install. Close Revit and rebuild, or build with -p:DeployToRevit=false to compile only." />

    <ItemGroup>
      <AddinFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <!-- No ContinueOnError: a copy that fails must break the build, not leave stale bits behind. -->
    <Copy SourceFiles="@(AddinFiles)" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\Sentinel\%(RecursiveDir)" />
    <Copy SourceFiles="Sentinel.addin" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)" />
  </Target>
</Project>
