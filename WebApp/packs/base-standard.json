{
  "key": "base-standard",
  "version": "1.0.0",
  "name": "Base standard (office-agnostic)",
  "description": "Generic ISO 19650 starter any office adopts and overlays: container naming, a sheet-number rule, element data requirements (IDS), a DWG layer map and an IFC delivery contract. Nothing office-specific — install it on the office, then overlay a project with its own artefact of any kind.",
  "author": "Sentinel",
  "tags": [
    "ISO",
    "Global",
    "Base"
  ],
  "ruleset": {
    "standard_key": "base-standard",
    "semver": "1.0.0",
    "rules": [
      {
        "id": "SN-01",
        "target": "sheet",
        "mode": "request",
        "tokens": [
          "PROJECT",
          "ORIGINATOR",
          "VOLUME",
          "LEVEL",
          "TYPE",
          "DISCIPLINE",
          "NUMBER"
        ],
        "token_defs": {
          "PROJECT": "[A-Z0-9]{2,10}",
          "ORIGINATOR": "[A-Z]{2,6}",
          "VOLUME": "[A-Z0-9]{2}",
          "LEVEL": "[A-Z0-9]{2}",
          "TYPE": "M3|DR|SP|SH",
          "DISCIPLINE": "A|S|M|E|P|L",
          "NUMBER": "[0-9]{4}"
        },
        "separator": "_",
        "message_en": "Sheet '{name}' does not match the 7-field Base container string PROJECT_ORIGINATOR_VOLUME_LEVEL_TYPE_DISCIPLINE_NUMBER.",
        "message_ar": "رقم اللوحة '{name}' لا يطابق سلسلة الحاوية الأساسية ذات السبعة حقول.",
        "doc_ref": "ISO 19650-2 §5.1.7 · Base standard pack"
      }
    ]
  },
  "naming": {
    "standard_key": "base-iso19650-naming",
    "semver": "1.0.0",
    "title": "Base ISO 19650 container naming (generic)",
    "separator": "_",
    "strip_extensions": [
      ".ifc",
      ".ifczip",
      ".rvt",
      ".nwc",
      ".nwd",
      ".pdf"
    ],
    "enforce": "reject",
    "_note": "Office-agnostic starter. Copy, rename fields to your convention, adjust enums. Same schema as the pilot standard's ruleset - the engine reads whatever is here.",
    "fields": [
      {
        "key": "project",
        "label": "Project code",
        "pattern": "^[A-Z0-9]{2,10}$"
      },
      {
        "key": "originator",
        "label": "Originator",
        "pattern": "^[A-Z]{2,6}$"
      },
      {
        "key": "volume",
        "label": "Volume/system",
        "placeholders": [
          "ZZ",
          "XX"
        ],
        "pattern": "^[A-Z0-9]{2}$"
      },
      {
        "key": "level",
        "label": "Level",
        "placeholders": [
          "ZZ",
          "XX"
        ],
        "pattern": "^[A-Z0-9]{2}$"
      },
      {
        "key": "type",
        "label": "Document type",
        "enum": [
          "M3",
          "DR",
          "SP",
          "SH"
        ]
      },
      {
        "key": "discipline",
        "label": "Discipline",
        "enum": [
          "A",
          "S",
          "M",
          "E",
          "P",
          "L"
        ]
      },
      {
        "key": "number",
        "label": "Number",
        "pattern": "^[0-9]{4}$"
      }
    ]
  },
  "ids": {
    "title": "Base element data requirements (generic)",
    "enforce": "warn",
    "_note": "Office-agnostic starter. Server-side custody: install it as the project's IDS artefact (Documents → Compile to IDS → Install on this project, or `node bridge/artefact-import.mjs config/base-standard/ids.json --project <key> --kind ids`) to make it authoritative.",
    "specifications": [
      {
        "name": "Walls carry fire rating",
        "applicability": {
          "entity": "IFCWALL"
        },
        "requirements": {
          "attributes": [],
          "properties": [
            {
              "pset": "Pset_WallCommon",
              "name": "FireRating",
              "cardinality": "required"
            }
          ]
        }
      },
      {
        "name": "All elements have a name",
        "applicability": {
          "entity": "IFC.*"
        },
        "requirements": {
          "attributes": [
            {
              "name": "Name",
              "cardinality": "required"
            }
          ],
          "properties": []
        }
      },
      {
        "name": "Slabs carry load-bearing flag",
        "applicability": {
          "entity": "IFCSLAB"
        },
        "requirements": {
          "attributes": [],
          "properties": [
            {
              "pset": "Pset_SlabCommon",
              "name": "LoadBearing",
              "cardinality": "required"
            }
          ]
        }
      }
    ]
  },
  "layers": {
    "$schema": "https://sentinel.dev/schemas/dwg-layers-v1.json",
    "version": 1,
    "standard": "Base AIA-style DWG Layer Standard v1",
    "doc": "config/base-standard/README.md",
    "format": "D-MAJR[-MINR]",
    "enforce": "warn",
    "match": {
      "caseInsensitive": true,
      "trim": true
    },
    "ignore": [
      "0",
      "DEFPOINTS",
      "*-ANNO",
      "*-ANNO-*",
      "*-IDEN",
      "*-PATT",
      "*-OVHD",
      "*-HRAL",
      "*-OTLN-*",
      "*-LEVL",
      "A-VRTC*",
      "Q-SPCQ*",
      "L-PLNT*",
      "L-SITE*",
      "G-*",
      "SD-*",
      "*-TTLB*",
      "*-PLOT*"
    ],
    "_note_aia_ignore": "IDEN=tags, PATT=hatching, OVHD=overhead dashed, HRAL=handrails (real geometry but not LOD-200 primary), LEVL=level annotation, VRTC=vertical-circulation symbols, SPCQ=space/area queries, L-*=landscape, G-/SD-=general/site-detail sheets, TTLB/PLOT=title block.",
    "disciplines": {
      "A": "Architectural",
      "S": "Structural",
      "M": "Mechanical",
      "E": "Electrical",
      "P": "Plumbing",
      "F": "Fire protection",
      "C": "Civil",
      "I": "Interiors",
      "G": "General"
    },
    "layers": [
      {
        "layer": "A-WALL",
        "category": "Walls",
        "family": "Generic_Wall",
        "params": {
          "Discipline": "A"
        },
        "aliases": [
          "A-WALL-EXT",
          "A-WALL-INT",
          "A-WALL-FULL",
          "A-WALL-PRHT"
        ]
      },
      {
        "layer": "A-DOOR",
        "category": "Doors",
        "family": "Generic_Door",
        "params": {
          "Discipline": "A"
        },
        "aliases": [
          "A-DOOR-FRAM"
        ]
      },
      {
        "layer": "A-GLAZ",
        "category": "Windows",
        "family": "Generic_Window",
        "params": {
          "Discipline": "A"
        },
        "aliases": [
          "A-GLAZ-FULL",
          "A-WIND"
        ]
      },
      {
        "layer": "A-FLOR",
        "category": "Floors",
        "family": "Generic_Floor",
        "params": {
          "Discipline": "A"
        },
        "aliases": [
          "A-FLOR-OTLN"
        ]
      },
      {
        "layer": "S-COLS",
        "category": "Columns",
        "family": "Generic_Column",
        "params": {
          "Discipline": "S"
        },
        "aliases": [
          "S-COLS-CONC",
          "S-COLS-STL"
        ]
      }
    ],
    "extensions": []
  },
  "contract": {
    "schema_version": 1,
    "contract_key": "base-default",
    "ifc_schema": "IFC2X3",
    "required_entities": [],
    "required_psets": [],
    "required_properties": [],
    "forbidden_entities": [
      {
        "entity": "IFCBUILDINGELEMENTPROXY",
        "max_count": 2147483647,
        "max_ratio": 0.25
      }
    ],
    "require_georeference": false
  }
}
