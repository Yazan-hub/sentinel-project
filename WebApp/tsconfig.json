{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "paths": {
      "@thatopen/components": ["./node_modules/@thatopen-platform/components-beta"],
      "@thatopen/components-front": ["./node_modules/@thatopen-platform/components-front-beta"],
      "@thatopen/fragments": ["./node_modules/@thatopen-platform/fragments-beta"]
    }
  },
  "include": ["src"]
}
