{
  "name": "Sentinel",
  "version": "1.0.41",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-fragments-worker.mjs && thatopen serve",
    "build": "node scripts/build-fragments-worker.mjs && vite build",
    "test": "vitest run",
    "security:check": "node db/security-check.mjs",
    "login": "thatopen login --local",
    "publish": "node scripts/build-fragments-worker.mjs && thatopen publish",
    "bridge:watch": "node bridge/watch-outbox.mjs",
    "bcf:serve": "node bridge/bcf-service.mjs",
    "build:bridge-core": "esbuild src/sentinel-core/bridge-entry.ts --bundle --format=esm --platform=node --outfile=bridge/sentinel-core.mjs",
    "mcp:serve": "node bridge/mcp-server.mjs",
    "start": "node bridge/bcf-service.mjs",
    "prepare": "node scripts/build-fragments-worker.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@lit/context": "^1.1.6",
    "@markerjs/markerjs3": "^3.9.0",
    "@sparkjsdev/spark": "^0.1.10",
    "@supabase/supabase-js": "^2.110.7",
    "@thatopen-platform/components-beta": "3.5.18",
    "@thatopen-platform/components-front-beta": "3.5.16",
    "@thatopen-platform/fragments-beta": "3.5.9",
    "@thatopen/fragments": "^3.4.7",
    "@thatopen/services": "0.16.1",
    "@thatopen/ui": "~3.4.4",
    "3d-tiles-renderer": "^0.4.28",
    "camera-controls": "^3.1.2",
    "lit": "^3.0.0",
    "mammoth": "^1.12.0",
    "opentype.js": "1.3.4",
    "potree-core": "^2.0.15",
    "socket.io-client": "4.8.3",
    "three": "0.185.0",
    "unpdf": "^1.8.0",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "typescript": "^5.2.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
