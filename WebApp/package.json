{
  "name": "Sentinel",
  "version": "1.0.18",
  "private": true,
  "scripts": {
    "dev": "thatopen serve",
    "build": "vite build",
    "test": "vitest run",
    "security:check": "node db/security-check.mjs",
    "login": "thatopen login --local",
    "publish": "thatopen publish",
    "bridge:upload": "node bridge/upload-ifc.mjs",
    "bridge:watch": "node bridge/watch-outbox.mjs",
    "bcf:serve": "node bridge/bcf-service.mjs",
    "build:bridge-core": "esbuild src/sentinel-core/bridge-entry.ts --bundle --format=esm --platform=node --outfile=bridge/sentinel-core.mjs",
    "mcp:serve": "node bridge/mcp-server.mjs",
    "start": "node bridge/bcf-service.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@lit/context": "^1.1.6",
    "@markerjs/markerjs3": "^3.9.0",
    "@sparkjsdev/spark": "^0.1.10",
    "@supabase/supabase-js": "^2.110.7",
    "@thatopen/components": "^3.4.8",
    "@thatopen/components-front": "^3.4.4",
    "@thatopen/fragments": "^3.4.7",
    "@thatopen/services": "^0.3.11",
    "@thatopen/ui": "~3.4.4",
    "3d-tiles-renderer": "^0.4.28",
    "camera-controls": "^3.1.2",
    "lit": "^3.0.0",
    "opentype.js": "1.3.4",
    "potree-core": "^2.0.15",
    "three": "0.185.0",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "typescript": "^5.2.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
