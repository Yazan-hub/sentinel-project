# Sentinel Platform — pilot configuration. Copy this file to `.env` and adjust.

# ── App → service ─────────────────────────────────────────────────────────────
# Where the web app reaches the Sentinel service (BCF issues + projects + RFIs +
# tenders + standards packs). Read at build time by Vite.
#   Local (default):  http://localhost:4100   ← each user runs the service on their machine
#   Hosted pilot:     http://SERVER-HOST:4100 ← one shared service for the whole office
VITE_SENTINEL_SERVICE=http://localhost:4100

# ── Service-side (set these in the SHELL before `npm run bcf:serve`, not here) ──
# These are read by bridge/bcf-service.mjs as process env vars:
#   BCF_PORT=4100                                    # service port
#   SENTINEL_OLLAMA_URL=http://localhost:11434/api/generate   # Copilot free-form + doc ingest (optional)
#   SENTINEL_LLM_MODEL=llama3
